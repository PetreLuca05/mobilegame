# Writes build_info.h with the commit the binary is built from ("-dirty" if
# tracked files outside docs/ differ). Rewritten only when it changes.
execute_process(COMMAND git rev-parse --short=7 HEAD WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git diff --quiet HEAD -- . ":!docs" WORKING_DIRECTORY ${SRC} RESULT_VARIABLE dirty)
if(dirty)
  set(hash "${hash}-dirty")
endif()
set(content "#define MG_BUILD_COMMIT \"${hash}\"\n")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE ${OUT} "${content}")
endif()
