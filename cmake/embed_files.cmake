# Script mode: cmake -DOUT=<file.c> -DBASE=<dir> -DFILES="a;b;c" -P embed_files.cmake
# Writes a C file with one byte array per input file plus a lookup table
# consumed by engine/core/assets.c (mg_asset_find).
cmake_minimum_required(VERSION 3.28)

set(body "/* generated by cmake/embed_files.cmake - do not edit */\n#include <stddef.h>\n#include \"core/assets.h\"\n\n")
set(table "")
set(index 0)
foreach(f IN LISTS FILES)
  file(RELATIVE_PATH rel "${BASE}" "${f}")
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  # break into lines of 32 bytes to keep compilers happy
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" hex "${hex}")
  string(APPEND body "static const unsigned char mg_asset_${index}[${size} + 1] = {\n${hex}0x00};\n")
  string(APPEND table "  { \"${rel}\", mg_asset_${index}, ${size} },\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "\nconst MgAsset mg_assets[] = {\n${table}  { NULL, NULL, 0 }\n};\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
