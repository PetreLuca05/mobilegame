#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct PSMain_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct PSMain_in
{
    float2 i_uv [[user(locn0)]];
};

fragment PSMain_out PSMain(PSMain_in in [[stage_in]], texture2d<float> u_src [[texture(0)]], sampler u_src_sampler [[sampler(0)]])
{
    PSMain_out out = {};
    out._entryPointOutput = u_src.sample(u_src_sampler, in.i_uv);
    return out;
}

