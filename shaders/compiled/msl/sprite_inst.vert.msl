#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FrameVS
{
    float4x4 u_view_proj;
};

struct VSMain_out
{
    float3 _entryPointOutput_wpos [[user(locn0)]];
    float3 _entryPointOutput_nrm [[user(locn1)]];
    half4 _entryPointOutput_col [[user(locn2)]];
    half4 _entryPointOutput_tint [[user(locn3)]];
    half4 _entryPointOutput_params [[user(locn4)]];
    float4 gl_Position [[position]];
};

struct VSMain_in
{
    float3 i_pos [[attribute(0)]];
    float3 i_nrm [[attribute(1)]];
    float4 i_col [[attribute(2)]];
    float4 i_row0 [[attribute(3)]];
    float4 i_row1 [[attribute(4)]];
    float4 i_row2 [[attribute(5)]];
    float4 i_tint [[attribute(6)]];
    float4 i_params [[attribute(7)]];
};

vertex VSMain_out VSMain(VSMain_in in [[stage_in]], constant FrameVS& _88 [[buffer(1)]])
{
    VSMain_out out = {};
    float4 _203 = float4(in.i_pos, 1.0);
    float _207 = dot(in.i_row0, _203);
    float _211 = dot(in.i_row1, _203);
    float _215 = dot(in.i_row2, _203);
    out.gl_Position = _88.u_view_proj * float4(_207, _211, _215, 1.0);
    out._entryPointOutput_wpos = float3(_207, _211, _215);
    out._entryPointOutput_nrm = in.i_nrm;
    out._entryPointOutput_col = half4(in.i_col);
    out._entryPointOutput_tint = half4(in.i_tint);
    out._entryPointOutput_params = half4(in.i_params);
    return out;
}

