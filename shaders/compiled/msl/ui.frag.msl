#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct PSMain_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct PSMain_in
{
    float2 i_uv [[user(locn0)]];
    float4 i_col [[user(locn1)]];
};

fragment PSMain_out PSMain(PSMain_in in [[stage_in]], texture2d<float> u_atlas [[texture(0)]], sampler u_sampler [[sampler(0)]])
{
    PSMain_out out = {};
    float4 _98 = u_atlas.sample(u_sampler, in.i_uv);
    float _99 = _98.x;
    float _103 = fast::max(fwidth(_99), 0.001000000047497451305389404296875) * 0.699999988079071044921875;
    float _112 = smoothstep(0.5 - _103, 0.5 + _103, _99) * in.i_col.w;
    out._entryPointOutput = float4(in.i_col.xyz * _112, _112);
    return out;
}

