#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct PSMain_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct PSMain_in
{
    half4 i_col [[user(locn2)]];
    half4 i_tint [[user(locn3), flat]];
};

fragment PSMain_out PSMain(PSMain_in in [[stage_in]])
{
    PSMain_out out = {};
    out._entryPointOutput = float4(half4(in.i_col.xyz * in.i_tint.xyz, half(1.0)));
    return out;
}

