    float _389 = fast::max(fwidth(_352), 9.9999997473787516355514526367188e-05);
    float _403 = fast::max(fwidth(_352), 9.9999997473787516355514526367188e-05);
    float _383 = (0.550000011920928955078125 * smoothstep(-_389, _389, _352)) + (0.449999988079071044921875 * smoothstep(0.449999988079071044921875 - _403, 0.449999988079071044921875 + _403, _352));
