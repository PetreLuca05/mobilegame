#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct DrawFS
{
    float4 u_tint;
    float4 u_params;
    float4 u_light_index[2];
};

struct PSMain_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct PSMain_in
{
    float4 i_col [[user(locn2)]];
};

fragment PSMain_out PSMain(PSMain_in in [[stage_in]], constant DrawFS& _26 [[buffer(0)]])
{
    PSMain_out out = {};
    out._entryPointOutput = float4(in.i_col.xyz * _26.u_tint.xyz, 1.0);
    return out;
}

